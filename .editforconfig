# 이 파일이 프로젝트의 최상위 설정임을 나타냅니다.
# (상위 폴더의 다른 .editorconfig 파일을 무시합니다)
root = true

# 모든 파일에 적용될 기본 규칙
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python 파일(.py)에만 특별히 적용될 규칙
[*.py]
indent_style = space
indent_size = 4

# Markdown 파일(.md)에만 적용될 규칙
[*.md]
trim_trailing_whitespace = false